# Optional copy for `vercel dev` (reads env from repo root, not source/).
# Easiest: duplicate the SERVER vars from source/.env.local here.
# Frontend VITE_* can stay only in source/.env.local.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY
LLM_MODEL=deepseek/deepseek-v4.1-flash
# LLM_FALLBACK_MODELS=google/gemini-2.0-flash-001
