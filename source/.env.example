# Frontend (Vite exposes only VITE_* to the browser)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server / API (same file is fine — Vite does not expose these)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY
# Use a model OpenRouter actually serves (bad ids 404 then burn the first 10s budget).
LLM_MODEL=deepseek/deepseek-v4.1-flash
# LLM_FALLBACK_MODELS=google/gemini-2.0-flash-001
# Optional: npm run test:llm / test:analysis (defaults 45s attempt, 90s total)
# LLM_SMOKE_ATTEMPT_MS=45000
# LLM_SMOKE_TOTAL_CAP_MS=90000

# Optional: only if API is on another origin during local split-dev
# VITE_API_BASE=http://127.0.0.1:3000

# Demo only: enable POST /api/reset-demo (server-side flag; not a VITE_ var)
# ALLOW_DEMO_RESET=true
